# Copy this file to .env and fill in your keys.

# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Tavily API key for richer real-time search
# Sign up at https://tavily.com — free tier available
# If not set, falls back to duckduckgo-search (no key required)
TAVILY_API_KEY=tvly-...

# Optional — directory for session and profile storage (default: ./data)
DATA_DIR=./data
